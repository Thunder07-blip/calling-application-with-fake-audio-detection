# ╔══════════════════════════════════════════════════════════════╗
# ║   Safe Call Platform — Environment Configuration Template   ║
# ║                                                              ║
# ║   📋 INSTRUCTIONS:                                          ║
# ║   1. Copy this file:  cp .env.example .env                  ║
# ║   2. Fill in your real values below                          ║
# ║   3. NEVER commit .env to version control                   ║
# ╚══════════════════════════════════════════════════════════════╝

# ── LiveKit (WebRTC Media Server) ──────────────────────────────
# Sign up at https://cloud.livekit.io to get these credentials.
# For LOCAL dev with Docker, the defaults (devkey/secret) work out of the box.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# For CLOUD deployment (e.g., LiveKit Cloud), use:
# LIVEKIT_API_KEY=your_livekit_cloud_api_key
# LIVEKIT_API_SECRET=your_livekit_cloud_api_secret
# LIVEKIT_URL=wss://your-project.livekit.cloud

# ── Database (PostgreSQL) ─────────────────────────────────────
# For LOCAL dev: the docker-compose default connects automatically.
# For CLOUD (Railway/Render): paste the provided DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@db:5432/safecall

# ── Backend API URL ───────────────────────────────────────────
# Used by the Flutter client to fetch LiveKit tokens.
# LOCAL:  http://<your-pc-ip>:8000
# CLOUD:  https://your-backend.onrender.com (or Railway URL)
BACKEND_URL=http://localhost:8000

# ── Network Configuration (Local Dev Only) ────────────────────
# Set this to your PC's local WiFi/LAN IP address for phone testing.
# Find it with: ipconfig (Windows) or ifconfig (macOS/Linux)
# Not needed when deploying to cloud.
LIVEKIT_NODE_IP=192.168.1.100

# ── LiveKit Room ──────────────────────────────────────────────
# The default room name the ML agent joins to monitor calls.
ROOM_NAME=testroom
