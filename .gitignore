# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment Variables
.env

# Virtual Environment
venv/
env/
.venv/

# OS specific
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/

# Ignore test media
*.wav
*.mp3

# ML model weights (large binary files — tracked via Git LFS in baseline_backup)
*.pth
*.pt

# ALLOW baseline backup models through (Git LFS handles the .pth)
!ml_agent_python/models/baseline_backup/**
!ml_agent_python/models/baseline_backup/*.pth
# NOTE: wav2vec2 model.safetensors (1.2GB) is NOT pushed — it auto-downloads from HuggingFace
*.safetensors

# Flutter build output
client_flutter/build/

# Logs
backend_logs.txt
*.log

# Recordings (local only, not pushed)
ml_agent_python/recordings/
